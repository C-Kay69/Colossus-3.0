{
  "name": "medpay-instant",
  "version": "1.0.0",
  "private": true,
  "description": "MedPay Instant - hospital discharge & gap-financing portal (Node.js + Tailwind CSS)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/styles.css --watch",
    "start": "npm run build:css && node server.js",
    "dev": "concurrently \"npm:watch:css\" \"node --watch server.js\""
  },
  "dependencies": { "express": "^4.21.2", "multer": "^2.0.2" },
  "devDependencies": { "concurrently": "^8.2.2", "tailwindcss": "^3.4.17" }
}
